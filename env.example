# ============================================================
# VMQFox 本地开发 / 单机部署配置模板
# 用法：cp env.example .env 后逐项填写。
# 适用：直接运行 ./vmqfox-api 或 go run cmd/vmqfox-api/main.go，
#       数据库为本机 MySQL（本仓库当前调试环境即此模式）。
# 若改用 docker compose 部署：请优先使用 env.production.example；
#       确需沿用本文件时必须把 VMQ_DB_HOST 改为 mysql（容器服务名），
#       否则 API 容器会把 127.0.0.1 当成自己而连不上数据库。
# 读取规则：Go 进程启动时读取工作目录（或其上一级）的 .env；
#       系统环境变量优先级高于 .env，同名项不会被 .env 覆盖。
# 别名说明：VMQ_* 变量大多存在旧 PHP 时代别名（DB_HOSTNAME、TOKEN_SECRET、
#       WRITE_MODE、APP_FRONTEND_URL、NOTIFY_ALLOW_CIDR 等），同名规范值优先；
#       新配置一律使用 VMQ_* 规范名，别名仅为兼容保留。
# 严禁把填好真实密钥的 .env 提交到仓库（.gitignore 已忽略 .env）。
# ============================================================

# ------------------------------------------------------------
# 一、服务与对外地址
# ------------------------------------------------------------
# API 监听地址与端口。0.0.0.0 表示接受任意网卡连接。
VMQ_SERVER_HOST=0.0.0.0
VMQ_SERVER_PORT=8080
# Gin 运行模式：release（生产/日常）或 debug（排障时输出更详细路由日志）。
VMQ_SERVER_MODE=release

# 收银台前端的买家可达地址。isHtml=1 建单时后端返回的跳转目标为
# <VMQ_FRONTEND_URL>/#/payment/<publicToken>，前端页面就嵌在本服务 / 路径，
# 因此单机调试直接填 API 自身地址（结尾不要带 /）。
# ⚠ 真实事故教训：此处若残留示例占位符（含字面 < > 尖括号）或写了买家
#   打不开的地址，浏览器会静默拒绝跳转，买家永远卡在「正在跳转到支付页面...」。
#   手机实测时改为局域网 IP，例如 http://192.168.2.10:8080。
VMQ_FRONTEND_URL=http://127.0.0.1:8080

# 允许跨域访问 API 的精确 Origin（逗号分隔）。
# 留空表示拒绝所有跨域请求；前后端同源部署无需配置，也不接受通配符 "*"。
VMQ_ALLOWED_ORIGIN=

# 运行角色：writer=正常读写；shadow=影子模式，写接口一律拒绝（用于双跑对比验证）。
VMQ_RUNTIME_MODE=writer

# ------------------------------------------------------------
# 二、令牌（必填，不填服务直接启动失败）
# ------------------------------------------------------------
# 管理端访问令牌的 HMAC 签名密钥。生成：openssl rand -hex 32
# 长度不得少于 32 个字符，且不要与任何其他系统复用。
VMQ_TOKEN_SECRET=
VMQ_TOKEN_ISSUER=vmqfox
# 令牌有效期。必填项（无默认值），支持 "12h"、"30m" 或纯秒数。
VMQ_TOKEN_TTL=24h

# ------------------------------------------------------------
# 三、数据库
# ------------------------------------------------------------
VMQ_DB_HOST=127.0.0.1
VMQ_DB_PORT=3306
VMQ_DB_NAME=vmq
VMQ_DB_USER=vmqfox
VMQ_DB_PASSWORD=
VMQ_DB_CHARSET=utf8mb4
# 连接池：最大打开 / 最大空闲连接数，MAX_IDLE 不得大于 MAX_OPEN。
VMQ_DB_MAX_OPEN_CONNS=50
VMQ_DB_MAX_IDLE_CONNS=10
# 连接最长存活时间，防止 MySQL wait_timeout 静默断开后拿到死连接。
VMQ_DB_CONN_MAX_LIFETIME=1h

# ------------------------------------------------------------
# 四、HTTP 服务器超时（不填使用括号内默认值）
# ------------------------------------------------------------
# 读取请求头超时（5s），防御慢速请求头攻击（Slowloris）。
VMQ_SERVER_READ_HEADER_TIMEOUT=5s
# 读取请求体超时（30s）。
VMQ_SERVER_READ_TIMEOUT=30s
# 写响应超时（30s），二维码图片生成等重接口也在此窗口内。
VMQ_SERVER_WRITE_TIMEOUT=30s
# Keep-Alive 空闲连接回收时间（60s）。
VMQ_SERVER_IDLE_TIMEOUT=60s
# 优雅停机时等待在途请求完成的最长时间（10s）。
VMQ_SERVER_SHUTDOWN_TIMEOUT=10s

# ------------------------------------------------------------
# 五、异步任务
# ------------------------------------------------------------
# 商户通知 worker：轮询间隔 / 单次通知超时 / 任务租约 / 每批条数（1~100）。
# 注意：LEASE_DURATION 必须严格大于 ATTEMPT_TIMEOUT，否则启动报错。
VMQ_NOTIFICATION_POLL_INTERVAL=2s
VMQ_NOTIFICATION_ATTEMPT_TIMEOUT=30s
VMQ_NOTIFICATION_LEASE_DURATION=45s
VMQ_NOTIFICATION_BATCH_SIZE=20
# 生命周期 worker：负责关闭超时订单 + 依据 lastheart 推导监控端状态 jkstate。
VMQ_LIFECYCLE_POLL_INTERVAL=10s
VMQ_LIFECYCLE_ATTEMPT_TIMEOUT=10s
VMQ_LIFECYCLE_BATCH_SIZE=100
# 心跳丢失超过该时长即判定监控端掉线（jkstate=0），期间新订单仍会受理。
# 建议不低于挂机端心跳间隔（30 秒）的 3 倍，避免网络抖动误判，默认 3m。
VMQ_MONITOR_HEARTBEAT_TIMEOUT=3m
# 挂机端签名时间戳允许的双向偏移窗口；手机与服务器时钟偏差超过此值，
# 心跳与收款推送会被全部拒绝（同时用于阻断被截获请求的重放）。
VMQ_MONITOR_SIGN_TTL=5m

# ------------------------------------------------------------
# 六、限流（进程内固定窗口，按客户端 IP 计数）
# ------------------------------------------------------------
# 多实例部署前应迁移到共享/网关限流。各窗口默认 1m。
# 登录尝试（防爆破）
VMQ_RATE_LOGIN_LIMIT=10
VMQ_RATE_LOGIN_WINDOW=1m
# 建单接口（防刷单）
VMQ_RATE_CREATE_LIMIT=30
VMQ_RATE_CREATE_WINDOW=1m
# 按 payId 恢复查询（与建单分开计数，避免超时重试挤占建单额度）
VMQ_RATE_QUERY_BY_PAY_ID_LIMIT=30
VMQ_RATE_QUERY_BY_PAY_ID_WINDOW=1m
# 订单公开查询 /order/get、/order/check（按 IP）
VMQ_RATE_PUBLIC_READ_LIMIT=60
VMQ_RATE_PUBLIC_READ_WINDOW=1m
# 订单公开查询（按 publicToken，防单链接被高频轮询）
VMQ_RATE_PUBLIC_TOKEN_LIMIT=60
VMQ_RATE_PUBLIC_TOKEN_WINDOW=1m
# 二维码生成
VMQ_RATE_QRCODE_LIMIT=30
VMQ_RATE_QRCODE_WINDOW=1m
# 挂机端心跳（App 默认 30s 一次，额度需覆盖多设备）
VMQ_RATE_MONITOR_HEART_LIMIT=120
VMQ_RATE_MONITOR_HEART_WINDOW=1m
# 挂机端收款推送
VMQ_RATE_MONITOR_PUSH_LIMIT=60
VMQ_RATE_MONITOR_PUSH_WINDOW=1m

# ------------------------------------------------------------
# 七、网络信任边界
# ------------------------------------------------------------
# 仅当 TCP 对端落在此列表（支持 CIDR 或单个 IP，逗号分隔）内时才解析
# X-Forwarded-For，防止客户端伪造 IP 绕过限流。
# 直连部署（无本地反代）保持为空：服务只信任 TCP 对端地址。
VMQ_TRUSTED_PROXY_CIDR=

# 出站商户通知的 SSRF 防护白名单：允许回调访问的内网 IP 或 CIDR（逗号分隔）。
# 默认拒绝一切回环/私网/链路本地地址。epay 与本服务同机部署时必须至少包含
# 127.0.0.1/32，否则 notifyUrl 会被「SSRF 拦截」打掉，订单永远停在未支付。
VMQ_NOTIFY_ALLOW_CIDR=127.0.0.1/32

# 出站商户通知默认只允许 https。设为 true 才接受明文 http，
# 该状态属于尚未关闭的安全门槛，仅用于兼容未升级 HTTPS 的存量商户。
VMQ_NOTIFY_ALLOW_HTTP=false

# ------------------------------------------------------------
# 八、docker compose 专用变量（直接 go run 时忽略本节）
# ------------------------------------------------------------
# 宿主机映射端口 -> 容器内 Go 服务的 8080。
VMQ_HTTP_PORT=8000
# compose 中 mysql 服务映射到宿主机的端口（已绑定 127.0.0.1，勿改成公网）。
VMQ_MYSQL_PORT=3306
# compose 中 mysql 服务的 root 口令，与业务账号使用不同口令。
MYSQL_ROOT_PASSWORD=
VMQFOX_BACKEND_IMAGE=vmqfox-backend:go-dev
TZ=Asia/Shanghai

# ============================================================
# 九、初始化动作（不在 .env 中完成）
# ------------------------------------------------------------
# 1. 建表 + 初始化管理员（一条命令，无需手工导入 database/schema.sql）：
#      交互式：./vmqfox-api -init-admin
#      自动化：./vmqfox-api -init-admin -username admin -password 'YourPassword' -force
#    该命令检测到库表不存在时会自动创建全部数据表；schema.sql 仅作为
#    表结构参考或 DBA 特殊场景手工建库用，正常部署不需要导入。
#    只想单独建表：./vmqfox-api -init-db。服务进程启动时不会自动建表，
#    务必先完成初始化再启动。
# 2. vmqfox 后台「通讯密钥」与 epay 后台「通讯密钥」填同一个强随机值。
# 3. epay 后台「接口地址」填买家浏览器可达的 vmqfox 地址（结尾带 /）；
#    本机联调用 http://127.0.0.1:8080/，手机实测必须用局域网 IP。
# ============================================================
