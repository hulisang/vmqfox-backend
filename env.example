# Go-only 部署配置。
# API 运行时不会创建数据表或管理员记录。

VMQ_SERVER_HOST=0.0.0.0
VMQ_SERVER_PORT=8080
VMQ_SERVER_MODE=release
# 买家可访问的最终公网 Origin，用于生成收银台链接。
# 单服务同源部署时与对外访问地址一致，例如 https://pay.example.com
VMQ_FRONTEND_URL=http://localhost:8000
# 允许跨域访问 API 的 Origin 列表（逗号分隔）。
# 留空表示拒绝所有跨域请求；同源部署无需配置，也不接受通配符 "*"。
VMQ_ALLOWED_ORIGIN=
VMQ_RUNTIME_MODE=writer

# 必填：使用至少 32 个字符的独立随机值。
VMQ_TOKEN_SECRET=
VMQ_TOKEN_ISSUER=vmqfox
VMQ_TOKEN_TTL=24h

VMQ_DB_HOST=127.0.0.1
VMQ_DB_PORT=3306
VMQ_DB_NAME=vmq
VMQ_DB_USER=vmqfox
VMQ_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
VMQ_DB_CHARSET=utf8mb4
VMQ_DB_MAX_OPEN_CONNS=50
VMQ_DB_MAX_IDLE_CONNS=10
VMQ_DB_CONN_MAX_LIFETIME=1h

VMQ_NOTIFICATION_POLL_INTERVAL=2s
VMQ_NOTIFICATION_ATTEMPT_TIMEOUT=30s
VMQ_NOTIFICATION_LEASE_DURATION=45s
VMQ_NOTIFICATION_BATCH_SIZE=20
VMQ_LIFECYCLE_POLL_INTERVAL=10s
VMQ_LIFECYCLE_ATTEMPT_TIMEOUT=10s
VMQ_LIFECYCLE_BATCH_SIZE=100
VMQ_MONITOR_HEARTBEAT_TIMEOUT=3m

# 挂机端签名时间戳允许的双向偏移窗口；超出窗口的心跳与推送一律拒绝，用于阻断被截获请求的重放
VMQ_MONITOR_SIGN_TTL=5m

# 进程内固定窗口限流；多实例部署前应迁移到共享/网关限流。
VMQ_RATE_LOGIN_LIMIT=10
VMQ_RATE_LOGIN_WINDOW=1m
VMQ_RATE_CREATE_LIMIT=30
VMQ_RATE_CREATE_WINDOW=1m
VMQ_RATE_PUBLIC_READ_LIMIT=60
VMQ_RATE_PUBLIC_READ_WINDOW=1m
VMQ_RATE_PUBLIC_TOKEN_LIMIT=60
VMQ_RATE_PUBLIC_TOKEN_WINDOW=1m
VMQ_RATE_QRCODE_LIMIT=30
VMQ_RATE_QRCODE_WINDOW=1m
VMQ_RATE_MONITOR_HEART_LIMIT=120
VMQ_RATE_MONITOR_HEART_WINDOW=1m
VMQ_RATE_MONITOR_PUSH_LIMIT=60
VMQ_RATE_MONITOR_PUSH_WINDOW=1m
# 仅填写实际反向代理网段；为空时服务只信任 TCP 连接对端地址，不读取 X-Forwarded-For。
VMQ_TRUSTED_PROXY_CIDR=

# SSRF 防护出站白名单:允许回调通知访问的内网 IP 或 CIDR 网段（多个用逗号分隔，如 192.168.1.0/24,10.0.0.5,127.0.0.1）
VMQ_NOTIFY_ALLOW_CIDR=

# 出站商户通知默认只允许 https。设为 true 才接受明文 http，
# 该状态属于尚未关闭的安全门槛，仅用于兼容未升级 HTTPS 的存量商户。
VMQ_NOTIFY_ALLOW_HTTP=false

# 对外暴露的 HTTP 端口，直接映射到容器内 Go 服务的 8080。
VMQ_HTTP_PORT=8000
VMQFOX_BACKEND_IMAGE=vmqfox-backend:go-dev
TZ=Asia/Shanghai

# 管理员初始化：
#   一键交互式运行：./vmqfox-api -init-admin（或 docker compose exec vmqfox-api ./vmqfox-api -init-admin）
#   自动化参数运行：./vmqfox-api -init-admin -username admin -password 'YourPassword' -force
# 不要把真实密码、哈希或完整凭据写入此文件并提交。