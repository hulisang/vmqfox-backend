# ============================================================
# VMQFox 生产环境配置模板
# 用法：cp env.production.example .env 后逐项替换所有 <> 占位符。
# 替换完成后必须复查：grep -n '<' .env 不得命中任何未替换的占位符，
#   尤其是 VMQ_FRONTEND_URL——残留 <...> 会让买家卡在支付跳转页（真实事故）。
# 部署前请确认：本文件同时被 Go 进程（config.loadDotEnv 读取 .env）
#   与 docker compose 变量插值共同消费，两者必须是同一份 .env。
# 读取规则：系统环境变量优先级高于 .env，同名项不会被 .env 覆盖；
#   VMQ_* 变量存在旧 PHP 别名（DB_HOSTNAME、TOKEN_SECRET、WRITE_MODE、
#   APP_FRONTEND_URL、NOTIFY_ALLOW_CIDR 等），规范名优先，新配置一律用规范名。
# 严禁把填好真实密钥的 .env 提交到仓库（.gitignore 已忽略 .env）。
# ============================================================

# ------------------------------------------------------------
# 一、服务与对外地址（最容易配错的部分）
# ------------------------------------------------------------
VMQ_SERVER_HOST=0.0.0.0
# 容器内监听端口；对外暴露由 compose 的 VMQ_HTTP_PORT 与反代决定。
VMQ_SERVER_PORT=8080
# 生产固定 release；debug 仅限临时排障，会泄露路由细节。
VMQ_SERVER_MODE=release

# 收银台前端的公网地址，必须是买家浏览器能打开的地址。
# isHtml=1 建单时后端返回的跳转目标为 <VMQ_FRONTEND_URL>/#/payment/<publicToken>，
# 此处若留 localhost、留空或残留 <> 占位符，买家会白屏或永远卡在跳转中间页。
# 结尾不要带 /。
VMQ_FRONTEND_URL=https://<pay.your-domain.com>

# 允许跨域的精确 Origin。留空表示拒绝所有跨域请求；单服务同源部署无需填写。
# 只有确实存在跨站调用方时才填，多个用逗号分隔，且不接受通配符 "*"。
VMQ_ALLOWED_ORIGIN=

# writer=正常读写；shadow=影子模式（写接口一律拒绝），仅用于双跑对比验证。
VMQ_RUNTIME_MODE=writer

# ------------------------------------------------------------
# 二、令牌（必填，不填服务直接启动失败）
# ------------------------------------------------------------
# 生成：openssl rand -hex 32
# 长度不得少于 32 个字符，且不要与任何其他系统复用。
VMQ_TOKEN_SECRET=<openssl rand -hex 32>
VMQ_TOKEN_ISSUER=vmqfox
# 令牌有效期。必填项（无默认值），支持 "12h"、"30m" 或纯秒数；
# 管理端长时间挂机依赖此值，调短会频繁掉线。
VMQ_TOKEN_TTL=12h

# ------------------------------------------------------------
# 三、数据库
# ------------------------------------------------------------
# 用 docker compose 部署时保持 mysql（服务名）；外置数据库填其内网地址。
VMQ_DB_HOST=mysql
VMQ_DB_PORT=3306
VMQ_DB_NAME=vmq
VMQ_DB_USER=vmqfox
# 生成：openssl rand -base64 24
VMQ_DB_PASSWORD=<strong-random-password>
VMQ_DB_CHARSET=utf8mb4
# 连接池：最大打开 / 最大空闲连接数，MAX_IDLE 不得大于 MAX_OPEN。
VMQ_DB_MAX_OPEN_CONNS=50
VMQ_DB_MAX_IDLE_CONNS=10
# 连接最长存活时间，必须小于 MySQL wait_timeout，防止拿到被静默断开的死连接。
VMQ_DB_CONN_MAX_LIFETIME=1h

# ------------------------------------------------------------
# 四、HTTP 服务器超时（不填使用括号内默认值）
# ------------------------------------------------------------
# 读取请求头超时（5s），防御慢速请求头攻击（Slowloris）。
VMQ_SERVER_READ_HEADER_TIMEOUT=5s
# 读取请求体超时（30s）。
VMQ_SERVER_READ_TIMEOUT=30s
# 写响应超时（30s），二维码图片生成等重接口也在此窗口内。
VMQ_SERVER_WRITE_TIMEOUT=30s
# Keep-Alive 空闲连接回收时间（60s）。
VMQ_SERVER_IDLE_TIMEOUT=60s
# 优雅停机时等待在途请求完成的最长时间（10s），应小于反代的 upstream 超时。
VMQ_SERVER_SHUTDOWN_TIMEOUT=10s

# ------------------------------------------------------------
# 五、异步任务
# ------------------------------------------------------------
# 商户通知 worker：轮询间隔 / 单次通知超时 / 任务租约 / 每批条数（1~100）。
# 约束：LEASE_DURATION 必须严格大于 ATTEMPT_TIMEOUT，否则启动报错。
VMQ_NOTIFICATION_POLL_INTERVAL=2s
VMQ_NOTIFICATION_ATTEMPT_TIMEOUT=30s
VMQ_NOTIFICATION_LEASE_DURATION=45s
VMQ_NOTIFICATION_BATCH_SIZE=20
# 生命周期 worker：负责关闭超时订单 + 依据 lastheart 推导监控端状态 jkstate。
VMQ_LIFECYCLE_POLL_INTERVAL=10s
VMQ_LIFECYCLE_ATTEMPT_TIMEOUT=10s
VMQ_LIFECYCLE_BATCH_SIZE=100
# 心跳丢失超过该时长即判定监控端掉线（jkstate=0），此后新订单被拒；
# 判定前（含本时长 + 一个轮询周期）订单仍会受理但无人监听收款。
# 建议不低于挂机端心跳间隔（30 秒）的 3 倍，避免网络抖动误判，默认 3m。
VMQ_MONITOR_HEARTBEAT_TIMEOUT=3m
# 挂机端签名时间戳允许的双向偏移窗口；手机与服务器时钟偏差超过此值，
# 心跳与收款推送会被全部拒绝（同时用于阻断被截获请求的重放）。
VMQ_MONITOR_SIGN_TTL=5m

# ------------------------------------------------------------
# 六、限流（生产必须结合下方信任代理一起配）
# ------------------------------------------------------------
# 进程内固定窗口限流。VMQ_TRUSTED_PROXY_CIDR 留空时所有请求的 client IP
# 都会被识别为网关容器地址，下列额度会被全站买家共享，务必先填信任代理。
# 多实例部署前应迁移到共享/网关限流。各窗口默认 1m。
# 登录尝试（防爆破）
VMQ_RATE_LOGIN_LIMIT=10
VMQ_RATE_LOGIN_WINDOW=1m
# 建单接口（防刷单）
VMQ_RATE_CREATE_LIMIT=60
VMQ_RATE_CREATE_WINDOW=1m
# 按 payId 恢复查询（与建单分开计数，避免超时重试挤占建单额度）
VMQ_RATE_QUERY_BY_PAY_ID_LIMIT=60
VMQ_RATE_QUERY_BY_PAY_ID_WINDOW=1m
# 订单公开查询 /order/get、/order/check（按 IP）
VMQ_RATE_PUBLIC_READ_LIMIT=120
VMQ_RATE_PUBLIC_READ_WINDOW=1m
# 订单公开查询（按 publicToken，防单链接被高频轮询）
VMQ_RATE_PUBLIC_TOKEN_LIMIT=120
VMQ_RATE_PUBLIC_TOKEN_WINDOW=1m
# 二维码生成
VMQ_RATE_QRCODE_LIMIT=60
VMQ_RATE_QRCODE_WINDOW=1m
# 挂机端心跳（App 默认 30s 一次，额度需覆盖全部监控设备）
VMQ_RATE_MONITOR_HEART_LIMIT=120
VMQ_RATE_MONITOR_HEART_WINDOW=1m
# 挂机端收款推送
VMQ_RATE_MONITOR_PUSH_LIMIT=60
VMQ_RATE_MONITOR_PUSH_WINDOW=1m

# ------------------------------------------------------------
# 七、网络信任边界（两项都必须按实际环境填写）
# ------------------------------------------------------------
# 只有 TCP 对端落在此列表内（支持 CIDR 或单个 IP，逗号分隔）时才解析
# X-Forwarded-For，防止客户端伪造 IP 绕过限流。
# 填上层反代（1Panel/OpenResty/自建 nginx）所在网段；该配置同时决定是否信任
# X-Forwarded-Proto，进而决定是否下发 HSTS。直接暴露端口时留空。
# 查询：docker network inspect vmqfox-backend_vmqfox-network -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
VMQ_TRUSTED_PROXY_CIDR=<172.x.0.0/16>

# 回调出站白名单。默认拒绝一切回环/私网/链路本地地址，
# 与 epay 同机部署时若不填，notifyUrl 会被 "SSRF 拦截" 打掉，订单永远停在未支付。
# 仅在 epay 与本服务确实位于内网时填写其地址或网段，公网回调则保持为空。
VMQ_NOTIFY_ALLOW_CIDR=

# 出站商户通知默认只允许 https。明文 http 会把签名后的回调内容暴露给链路中间人，
# 设为 true 表示显式接受该风险，属于尚未关闭的安全门槛。
VMQ_NOTIFY_ALLOW_HTTP=false

# ------------------------------------------------------------
# 八、容器编排
# ------------------------------------------------------------
# 单服务模型：Go 进程同时提供 /（嵌入的 React 前端）、/assets 与 /api，
# 不再存在独立前端容器。生产建议在前面加 TLS 反代，仅对外暴露 443；
# 下面这个端口不要直接开放到公网防火墙。
VMQ_HTTP_PORT=8000
# 宿主机映射的 MySQL 端口，compose 已绑定到 127.0.0.1，不要改成 0.0.0.0。
VMQ_MYSQL_PORT=3306
# compose 中 mysql 服务必填，与业务账号使用不同口令。生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=<another-strong-random-password>
VMQFOX_BACKEND_IMAGE=vmqfox-backend:go-prod
TZ=Asia/Shanghai

# ============================================================
# 九、上线后仍需在 .env 之外完成的动作
# ------------------------------------------------------------
# 1. 建表 + 初始化管理员（不要把密码写进本文件；无需手工导入 schema.sql，
#    该命令检测到库表不存在时会自动创建全部数据表）：
#      docker compose exec vmqfox-api ./vmqfox-api -init-admin
# 2. vmqfox 后台「通讯密钥」与 epay 后台「通讯密钥」填同一个强随机值。
# 3. epay 后台「接口地址」填 https://<pay.your-domain.com>/（公网可达、结尾带 /）；
#    该地址由买家浏览器直接访问，填 127.0.0.1 必然失败。
# 4. epay 后台「网站url / 本地url」填最终 https 地址：回调客户端不跟随 3xx，
#    http→https 的 301 会被判定为通知失败并反复重试。
# 5. 反代若自建 nginx，需一并搬运 docker/nginx/default.conf 中的
#    access log 脱敏 map，避免 publicToken 明文落盘；同时必须透传
#    X-Forwarded-Proto，且不要重复添加 CORS 或安全响应头（由 Go 统一下发）。
# 6. 确认 epay 的 location ^~ /plugins 与 /includes 的 deny all 生效，
#    并把 plugins 目录下的 *.bak 备份文件移出 web 根目录。
# ============================================================
